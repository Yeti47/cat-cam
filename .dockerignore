# Keep the build context small -- .venv alone is ~1.4 GB.
.venv/
.git/
.gitignore
__pycache__/
*.pyc
*.egg-info/

# Model weights are downloaded during the build, not copied in.
*.pt

# Frontend build artifacts: the image builds these itself.
frontend/node_modules/
frontend/dist/

# Runtime data lives in the named volume, never in the image.
snapshots/
ntfy-server/

# Local secrets / environment -- injected at run time.
.env

README.md
