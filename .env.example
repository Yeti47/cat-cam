# Copy to .env (gitignored) and fill in real values.
#
# Two groups live here:
#   - bare names are read by docker compose itself (ports, devices)
#   - CATCAM_* are read by the application (cat_cam/settings.py)
#
# Everything here is deploy-time and fixed for the life of the process.
# Detection tuning (thresholds, zone, retention) is managed in the Web UI
# and stored in the data volume -- not here, and not in git.

# --- compose-level ---

# Interface the ntfy server is published on -- the Netbird VPN IP, so the
# phone can reach it while the LAN and public internet cannot.
NTFY_BIND_IP=YOUR-NETBIRD-IP
NTFY_PORT=28419

# Must be the externally reachable URL, NOT the internal compose hostname:
# attachment links handed to the phone are built from this.
NTFY_BASE_URL=http://YOUR-NETBIRD-IP:28419

# v4l2 device passed into the container, and the host's "video" group id
# (`getent group video`) which the container needs to read it.
CAMERA_DEVICE=/dev/video1
VIDEO_GID=39

# --- app-level ---

CATCAM_CAMERA_DEVICE=/dev/video1
# Optional static crop "x,y,w,h" applied before anything else sees the
# frame, e.g. to trim letterbox bars. Leave unset for the full frame.
#CATCAM_CAMERA_CROP=0,60,1280,600

# Reached over the compose network, so the app never needs the Netbird IP.
CATCAM_NTFY_SERVER=http://ntfy
CATCAM_NTFY_TOPIC=catcam-CHANGE-ME
CATCAM_NTFY_ENABLED=true

CATCAM_DATA_DIR=/data
CATCAM_LOG_LEVEL=INFO
