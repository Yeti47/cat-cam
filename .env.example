# Copy to .env (gitignored) and fill in real values.
# These are infrastructure values that docker compose interpolates.
# App-level secrets (the ntfy topic) live in config.local.yaml instead.

# Interface the ntfy server is published on -- the Netbird VPN IP, so the
# phone can reach it while the LAN and public internet cannot.
NTFY_BIND_IP=YOUR-NETBIRD-IP
NTFY_PORT=28419

# Must be the externally reachable URL, NOT the internal compose hostname:
# attachment links handed to the phone are built from this.
NTFY_BASE_URL=http://YOUR-NETBIRD-IP:28419

# v4l2 device the DroidCam virtual camera shows up as.
CAMERA_DEVICE=/dev/video1

# GID of the host's "video" group -- the container needs it as a
# supplementary group to read the camera device (`getent group video`).
VIDEO_GID=39
