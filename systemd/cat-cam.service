[Unit]
Description=cat-cam - notify when a cat is at the door
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/source/repos/cat-cam
ExecStart=%h/source/repos/cat-cam/.venv/bin/python -m cat_cam.main --config %h/source/repos/cat-cam/config.yaml
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
